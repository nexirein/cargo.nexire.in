# Copy this file to .env.local and fill in real values.
# See docs/SETUP.md for where each value comes from.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser (never prefix with NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=
# Only needed locally for the Supabase CLI (migrations, `supabase link`).
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# --- Upstash Redis ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Upstash QStash (send queue) ---
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Set to "inline" for local dev (in-process queue, no public URL needed).
# Set to "qstash" in Preview/Production so real QStash drives sends.
QUEUE_DRIVER=inline

# --- Outbound mail transport ---
# "smtp" (default) sends via SMTP (Gmail App Password, any SMTP server).
# "graph" uses Microsoft Graph API (needs Azure AD app registration).
MAIL_DRIVER=smtp

# --- SMTP (outbound mail, MAIL_DRIVER=smtp) ---
# For Gmail: use smtp.gmail.com, port 587, enable App Passwords in
# Google Account settings, use your email as SMTP_USER and the 16-char
# app-specific password as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: the "From" address. Defaults to SMTP_USER if empty.
SMTP_FROM=

# --- IMAP (inbound reply polling) ---
# Every N minutes the IMAP poller runs and picks up unseen replies.
# IMAP_USER will also be the BCC target for sent pre-alerts.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# --- Microsoft Graph (outbound mail, MAIL_DRIVER=graph) ---
# Needed for Phase 2 when using prealert@fedex.com (Exchange Online).
# See docs/AZURE_AD_SETUP.md for setup instructions.
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# --- Public app URL (QStash and Power Automate callback target, must be
# reachable from the internet in Preview/Production) ---
APP_BASE_URL=http://localhost:3000

# --- Vercel Cron protection ---
CRON_SECRET=

# --- OpenAI (AI classifier + embeddings + draft generation) ---
OPENAI_API_KEY=

# --- Google Gemini (unused until the next phase, create the key now anyway) ---
GEMINI_API_KEY=
