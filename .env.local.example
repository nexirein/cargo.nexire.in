# Copy this file to .env.local and fill in real values.
# See docs/SETUP.md for where each value comes from.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser (never prefix with NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=
# Only needed locally for the Supabase CLI (migrations, `supabase link`).
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# --- Upstash Redis ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Upstash QStash (send queue) ---
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Set to "inline" for local dev (in-process queue, no public URL needed).
# Set to "qstash" in Preview/Production so real QStash drives sends.
QUEUE_DRIVER=inline

# --- Microsoft Graph (outbound mail) ---
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# --- Public app URL (QStash callback target, must be reachable from the internet) ---
APP_BASE_URL=http://localhost:3000

# --- Vercel Cron protection ---
CRON_SECRET=

# --- Google Gemini (unused until the next phase, create the key now anyway) ---
GEMINI_API_KEY=
