# Copy this file to .env.local and fill in real values.
# See docs/SETUP.md for where each value comes from.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser (never prefix with NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=
# Only needed locally for the Supabase CLI (migrations, `supabase link`).
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# --- Upstash Redis ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Upstash QStash (send queue) ---
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Set to "inline" for local dev (in-process queue, no public URL needed).
# Set to "qstash" in Preview/Production so real QStash drives sends.
QUEUE_DRIVER=inline

# --- Outbound mail transport ---
# "power_automate" (default) sends via the shared Power Automate flow —
# see docs/POWER_AUTOMATE.md. FedEx's tenant does not grant admin consent
# for a custom Graph app registration, so this is the real path.
# "graph" is kept working as a fallback for local testing or if tenant
# policy ever changes; it needs the AZURE_AD_* vars below.
MAIL_DRIVER=power_automate

# --- Power Automate (outbound mail, MAIL_DRIVER=power_automate) ---
# The "When an HTTP request is received" trigger URL from the shared flow.
# Treat this as a secret — it's a bearer credential via its embedded SAS
# signature. Never expose it client-side.
POWER_AUTOMATE_FLOW_URL=
# Shared secret the flow echoes back in its callback header so
# /api/power-automate/callback can verify the request really came from it.
POWER_AUTOMATE_CALLBACK_SECRET=

# --- Microsoft Graph (outbound mail, MAIL_DRIVER=graph fallback only) ---
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# --- Public app URL (QStash and Power Automate callback target, must be
# reachable from the internet in Preview/Production) ---
APP_BASE_URL=http://localhost:3000

# --- Vercel Cron protection ---
CRON_SECRET=

# --- Google Gemini (unused until the next phase, create the key now anyway) ---
GEMINI_API_KEY=
